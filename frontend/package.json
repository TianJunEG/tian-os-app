{
  "name": "tutor-match-frontend",
  "version": "1.0.0",
  "description": "Tutor Match Platform Frontend",
  "type": "module",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && vite",
    "build": "vite build && node scripts/postbuild-sw.cjs",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.pilot.config.js",
    "test:pilot-gate": "playwright test -c playwright.pilot.config.js -g \"pilot gate\"",
    "test:visual": "playwright test -c playwright.visual.config.js",
    "test:visual-update": "playwright test -c playwright.visual.config.js --update-snapshots"
  },
  "dependencies": {
    "@sentry/react": "^10.57.0",
    "@stripe/react-stripe-js": "^2.1.0",
    "@stripe/stripe-js": "^1.46.0",
    "axios": "^1.4.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.11.0",
    "remark-gfm": "^4.0.1",
    "vercel": "^54.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "vite": "^4.3.9",
    "vitest": "^1.6.1"
  }
}
