# Base URL of the backend API the frontend calls.
# Vite exposes any VITE_* variable to the app at build time.
# If unset, the app falls back to http://localhost:5001/api (see src/services/api.js).
# For production, set this when building, e.g.:
#   VITE_API_URL=https://api.yourdomain.com/api npm run build
VITE_API_URL=http://localhost:5001/api
