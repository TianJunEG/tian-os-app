# NOTE: every VITE_* value is baked into the shipped JS bundle at build time
# and is publicly visible. Only put publishable/non-secret values here.

# Base URL of the backend API, including the /api suffix.
# If unset, the app falls back to http://localhost:5001/api (see src/services/api.js).
VITE_API_URL=http://localhost:5001/api
# Production example:
# VITE_API_URL=https://tutor-match-api.onrender.com/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Privacy-first analytics (optional; leave unset to disable).
# Your site domain as registered in Plausible:
# VITE_PLAUSIBLE_DOMAIN=tianjun.edu.sg
# Only for a self-hosted Plausible/Umami-compatible script:
# VITE_PLAUSIBLE_SRC=https://analytics.tianjun.edu.sg/js/script.js
