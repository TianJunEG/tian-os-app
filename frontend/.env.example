# NOTE: every VITE_* value is baked into the shipped JS bundle at build time
# and is publicly visible. Only put publishable/non-secret values here.

# Base URL of the backend API, including the /api suffix.
# If unset, the app falls back to http://localhost:5001/api (see src/services/api.js).
VITE_API_URL=http://localhost:5001/api
# Production example:
# VITE_API_URL=https://tian-os-api.onrender.com/api
# Vercel preview/production: set this in Project Settings → Environment Variables.
# Vercel project settings:
#   Root Directory: frontend
#   Build Command: npm run build
#   Output Directory: dist
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# v0.2 Worksheet Generator (student)
# Keep false for production beta unless explicitly enabled.
VITE_ENABLE_WORKSHEETS=false

# Role/module flags for QA and controlled pilots. Keep disabled unless the
# corresponding surface is part of the pilot.
VITE_ENABLE_PARENT=false
VITE_ENABLE_TUTOR=false
VITE_ENABLE_TEACHER=false
VITE_ENABLE_LIFELAB=false
VITE_ENABLE_SCIENCE=false
VITE_ENABLE_SPELLING=false
VITE_ENABLE_FRACTIONS_STORY_MODE=false

# Privacy-first analytics (optional; leave unset to disable).
# Your site domain as registered in Plausible:
# VITE_PLAUSIBLE_DOMAIN=tianjun.edu.sg
# Only for a self-hosted Plausible/Umami-compatible script:
# VITE_PLAUSIBLE_SRC=https://analytics.tianjun.edu.sg/js/script.js
