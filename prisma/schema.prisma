generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum ReferenceStatus {
  active
  archived
}

model SubjectRef {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  displayOrder   Int      @default(0)
  legacyMongoId  String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topics TopicRef[]

  @@index([displayOrder])
  @@map("subjects")
}

model TopicRef {
  id             String   @id @default(cuid())
  subjectId      String
  name           String
  moeLevel       String?
  displayOrder   Int      @default(0)
  legacyMongoId  String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject SubjectRef @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  skills  SkillRef[]

  @@unique([subjectId, name])
  @@index([subjectId, displayOrder])
  @@map("topics")
}

model SkillRef {
  id                     String          @id @default(cuid())
  frameworkSkillId       String          @unique
  universalSkillSlug     String          @unique
  domain                 String
  title                  String
  description            String?
  pathwayOrder           Int
  difficultyBand         String?
  questionTypes          String[]        @default([])
  mistakeTypes           String[]        @default([])
  status                 ReferenceStatus @default(active)
  topicId                String?
  legacyMongoId          String?         @unique
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  topic TopicRef? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  prerequisitesAsSource SkillPrerequisite[] @relation("SkillPrerequisiteSource")
  prerequisitesAsTarget SkillPrerequisite[] @relation("SkillPrerequisiteTarget")
  curriculumMappings    CurriculumSkillMapping[]
  questionFamilies      QuestionFamilyRef[]

  @@index([domain, pathwayOrder])
  @@map("skills")
}

model SkillPrerequisite {
  id                     String   @id @default(cuid())
  skillId                String
  prerequisiteSkillId    String
  relationshipType       String   @default("required")
  legacySource           String?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  skill             SkillRef @relation("SkillPrerequisiteSource", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteSkill SkillRef @relation("SkillPrerequisiteTarget", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)

  @@unique([skillId, prerequisiteSkillId])
  @@index([prerequisiteSkillId])
  @@map("skill_prerequisites")
}

model CurriculumSkillMapping {
  id               String   @id @default(cuid())
  mappingKey       String   @unique
  skillId          String
  country          String
  curriculum       String
  subject          String
  phase            String
  stream           String?
  level            String?
  strand           String?
  subStrand        String?
  syllabusTopic    String?
  syllabusOutcome  String?
  introducedLevel  String?
  masteryLevel     String?
  levelBand        String[] @default([])
  sourceDocument   String?
  syllabusRef      String?
  notes            String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  skill SkillRef @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([country, curriculum, level])
  @@index([country, curriculum, stream, phase])
  @@map("curriculum_skill_mappings")
}

model QuestionFamilyRef {
  id                    String          @id @default(cuid())
  questionFamilyId      String          @unique
  domain                String
  skillId               String
  name                  String
  description           String?
  categorySupport       String[]        @default([])
  recommendedCount      Int?
  masteryTargetAccuracy Int?
  mentalMathEligible    Boolean         @default(false)
  workingRequired       Boolean         @default(true)
  assessmentRelevant    Boolean         @default(true)
  status                ReferenceStatus @default(active)
  legacyMongoId         String?         @unique
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  skill SkillRef @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([domain, skillId])
  @@index([domain, status])
  @@map("question_families")
}
