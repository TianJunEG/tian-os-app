# MathPath MVP environment

# MongoDB. If unset, the app falls back to a process-local in-memory store so the
# vertical slice still runs end-to-end (NOT durable — resets on restart).
MONGODB_URI=
MONGODB_DB=mathpath_mvp

# Anthropic API key for AI remediation messages. If unset, remediation uses a
# deterministic templated explanation (worked example + guided pattern still work).
ANTHROPIC_API_KEY=
