# MongoDB
MONGODB_URI=mongodb://localhost:27017/tutor-match
# Optional local override used by some seed scripts when remote Atlas is unavailable
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/tutor-match
# Production Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tian-os-staging?retryWrites=true&w=majority

# PostgreSQL / Prisma (Phase 0 scaffolding — Mongo remains runtime source)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tian_os?schema=public
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tian_os?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tian_os_shadow?schema=public
PGSSL=false

# Dual-database migration feature flags (do not switch runtime reads yet)
DB_READ_SOURCE=mongo
DB_DUAL_WRITE=false
DB_PARITY_LOG=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudflare R2 (lesson-recording audio storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=lesson-recordings
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# WhatsApp push (premium-home parent notifications). Leave unset to disable;
# notifications still deliver in-app and via the weekly email digest.
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token

# Email (production transport; dev uses an Ethereal test account)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="TutorMatch <noreply@tutormatch.com>"

# Where new partnership inquiry notifications are sent
# (falls back to EMAIL_FROM, then EMAIL_USER if unset)
PARTNERSHIPS_NOTIFICATION_EMAIL=partnerships@tianjun.example

# Server
# Render uses PORT from platform env; local default in server.js is 5001
PORT=5001
NODE_ENV=development

# Pilot/QA rate-limit controls. Production defaults remain conservative when
# these are unset: auth 10/15min, API 100/15min.
# QA_DISABLE_RATE_LIMIT=1
# AUTH_RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=300
# API_RATE_LIMIT_WINDOW_MS=900000

# Redis (Phase 1 scaling). When set, the rate limiter uses distributed Redis
# counters so limits hold across multiple instances; the background job queue
# (later) reuses the same connection. Leave UNSET to keep the in-process
# fallback (single-instance / local dev). See docs/architecture/Scaling_Phase1_Redis_JobQueue.md
# REDIS_URL=redis://localhost:6379

# Background job queue (Phase 1 WS3). When JOB_QUEUE_ENABLED=1 AND REDIS_URL is
# set, heavy operations (paper analysis OCR/AI) are run by the worker process
# (`npm run worker`) instead of inline, and those endpoints return 202 + poll.
# Leave unset/0 to keep the synchronous path. WORKER_CONCURRENCY caps jobs run
# in parallel per worker (default 2).
# JOB_QUEUE_ENABLED=1
# WORKER_CONCURRENCY=2

# AI provider for the math worksheet generator (photo analyze / mark / reinforce).
# Set at least one key. The active provider is auto-selected: Anthropic is
# preferred (its prompts/schemas are tuned for Claude) and OpenAI is used when
# only its key is present. Set WORKSHEET_AI_PROVIDER to force one explicitly.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
OPENAI_API_KEY=sk-your_openai_api_key
# WORKSHEET_AI_PROVIDER=anthropic   # or "openai" — overrides auto-selection

# Worksheet AI models (optional). A cheap primary model handles every call and
# escalates to the stronger model only when it can't read handwriting clearly.
# Anthropic models:
WORKSHEET_PRIMARY_MODEL=claude-haiku-4-5
WORKSHEET_ESCALATION_MODEL=claude-sonnet-4-6
# OpenAI models:
WORKSHEET_OPENAI_PRIMARY_MODEL=gpt-4o-mini
WORKSHEET_OPENAI_ESCALATION_MODEL=gpt-4o

# Comma-separated list of allowed frontend origins for CORS.
# Include local dev + production frontend URL(s).
# Example production:
# CORS_ORIGIN=https://tian-os.vercel.app,https://tian-os-git-main-yourteam.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional canonical frontend URL (used in deployment docs and sanity checks)
FRONTEND_URL=http://localhost:3000

# TutorMatch auto-matching (9-criteria compatibility scoring). Off for launch —
# the tutor search returns a plain directory (ranked by rating) with no match
# scores. Set to "true" to launch matching later. Tutor signup works regardless.
MATCHING_ENABLED=false
