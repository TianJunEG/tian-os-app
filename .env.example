# MongoDB
MONGODB_URI=mongodb://localhost:27017/tutor-match

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Server
PORT=5000
NODE_ENV=development

# Anthropic (Claude) — required for the math worksheet generator
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Worksheet AI models (optional). Cheap primary model handles every call;
# it escalates to the stronger model only when it can't read handwriting clearly.
WORKSHEET_PRIMARY_MODEL=claude-haiku-4-5
WORKSHEET_ESCALATION_MODEL=claude-sonnet-4-6
