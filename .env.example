# MongoDB
MONGODB_URI=mongodb://localhost:27017/tutor-match

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (production transport; dev uses an Ethereal test account)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="TutorMatch <noreply@tutormatch.com>"

# Where new partnership inquiry notifications are sent
# (falls back to EMAIL_FROM, then EMAIL_USER if unset)
PARTNERSHIPS_NOTIFICATION_EMAIL=partnerships@tianjun.example

# Server
PORT=5000
NODE_ENV=development

# AI provider for the math worksheet generator (photo analyze / mark / reinforce).
# Set at least one key. The active provider is auto-selected: Anthropic is
# preferred (its prompts/schemas are tuned for Claude) and OpenAI is used when
# only its key is present. Set WORKSHEET_AI_PROVIDER to force one explicitly.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
OPENAI_API_KEY=sk-your_openai_api_key
# WORKSHEET_AI_PROVIDER=anthropic   # or "openai" — overrides auto-selection

# Worksheet AI models (optional). A cheap primary model handles every call and
# escalates to the stronger model only when it can't read handwriting clearly.
# Anthropic models:
WORKSHEET_PRIMARY_MODEL=claude-haiku-4-5
WORKSHEET_ESCALATION_MODEL=claude-sonnet-4-6
# OpenAI models:
WORKSHEET_OPENAI_PRIMARY_MODEL=gpt-4o-mini
WORKSHEET_OPENAI_ESCALATION_MODEL=gpt-4o

# Comma-separated list of allowed frontend origins for CORS
# (in production, set to your deployed frontend URL)
CORS_ORIGIN=http://localhost:3000
