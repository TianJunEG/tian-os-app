# MongoDB
MONGODB_URI=mongodb://localhost:27017/tutor-match

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (production transport; dev uses an Ethereal test account)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="TutorMatch <noreply@tutormatch.com>"

# Where new partnership inquiry notifications are sent
# (falls back to EMAIL_FROM, then EMAIL_USER if unset)
PARTNERSHIPS_NOTIFICATION_EMAIL=partnerships@tianjun.example

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
# (in production, set to your deployed frontend URL)
CORS_ORIGIN=http://localhost:3000
